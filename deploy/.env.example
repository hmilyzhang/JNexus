# JNexus deployment secrets — copy this file to `.env` and edit before `docker compose up -d --build`.
# compose reads `.env` automatically; keep it OUT of git (already gitignored).

# --- Database (bundled postgres service) ---
JNEXUS_DB_USER=jnexus
JNEXUS_DB_PASSWORD=jnexus123
JNEXUS_DB_NAME=jnexus

# --- OpenObserve root credentials (shared by the openobserve service AND the
#     jnexus integration auto-seed; both containers must match) ---
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=Complexpass@123
